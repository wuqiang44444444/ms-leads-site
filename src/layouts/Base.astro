---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../../site.config.mjs";
import { pageUrl } from "../lib/urls.mjs";

const { title, description, keywords, path, jsonLd = [], robots = "index,follow" } = Astro.props;
const canonical = pageUrl(siteConfig, path);
const ogImage = pageUrl(siteConfig, "og.png");
const base = import.meta.env.BASE_URL;

function safeJson(data) {
  return JSON.stringify(data).replace(/</g, "\\u003c");
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#102536" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteConfig.brandFullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.brandName}：在客户自有订阅中接入 Azure OpenAI`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      jsonLd.map((entry) => (
        <script type="application/ld+json" set:html={safeJson(entry)} />
      ))
    }
  </head>
  <body>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
